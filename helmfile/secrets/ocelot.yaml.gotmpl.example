# Draft of secrets/ocelot.yaml.gotmpl: hands the environment secrets (environments/*.secrets.yaml)
# to the charts' `secrets.*` values. Derived from the charts (backend/webapp/imagor/neo4j
# secret.yaml, acme-issuer.yaml) because the other configurations keep this file sops-encrypted —
# compare it with a decrypted copy of one of them before use, then save it as ocelot.yaml.gotmpl
# and encrypt it (`sops encrypt -i`), as helmfile.yaml.gotmpl lists it under `secrets:`.
secrets:
  acme_email: {{ .StateValues.deploy.ACME_EMAIL | quote }}
  backend:
    env:
      JWT_SECRET: {{ .StateValues.jwt.JWT_SECRET | quote }}
      AWS_ACCESS_KEY_ID: {{ .StateValues.s3.AWS_ACCESS_KEY_ID | quote }}
      AWS_SECRET_ACCESS_KEY: {{ .StateValues.s3.AWS_SECRET_ACCESS_KEY | quote }}
      AWS_ENDPOINT: {{ .StateValues.s3.AWS_ENDPOINT | quote }}
      AWS_REGION: {{ .StateValues.s3.AWS_REGION | quote }}
      AWS_BUCKET: {{ .StateValues.s3.AWS_BUCKET | quote }}
      EMAIL_DEFAULT_SENDER: {{ .StateValues.email.EMAIL_DEFAULT_SENDER | quote }}
      SMTP_HOST: {{ .StateValues.email.SMTP_HOST | quote }}
      SMTP_USERNAME: {{ .StateValues.email.SMTP_USERNAME | quote }}
      SMTP_PASSWORD: {{ .StateValues.email.SMTP_PASSWORD | quote }}
      SMTP_PORT: {{ .StateValues.email.SMTP_PORT | quote }}
      SMTP_IGNORE_TLS: {{ .StateValues.email.SMTP_IGNORE_TLS | quote }}
      SMTP_SECURE: {{ .StateValues.email.SMTP_SECURE | quote }}
      SMTP_DKIM_PRIVATEKEY: {{ .StateValues.email.SMTP_DKIM_PRIVATEKEY | quote }}
      SMTP_DKIM_DOMAINNAME: {{ .StateValues.email.SMTP_DKIM_DOMAINNAME | quote }}
      SMTP_DKIM_KEYSELECTOR: {{ .StateValues.email.SMTP_DKIM_KEYSELECTOR | quote }}
      SMTP_MAX_CONNECTIONS: {{ .StateValues.email.SMTP_MAX_CONNECTIONS | quote }}
      IMAGOR_SECRET: {{ .StateValues.imagor.IMAGOR_SECRET | quote }}
      MAPBOX_TOKEN: {{ .StateValues.map.MAPBOX_TOKEN | quote }}
      LIVEKIT_URL: {{ .StateValues.livekit.LIVEKIT_URL | quote }}
      LIVEKIT_API_KEY: {{ .StateValues.livekit.LIVEKIT_API_KEY | quote }}
      LIVEKIT_API_SECRET: {{ .StateValues.livekit.LIVEKIT_API_SECRET | quote }}
  webapp:
    env:
      MAPBOX_TOKEN: {{ .StateValues.map.MAPBOX_TOKEN | quote }}
  imagor:
    env:
      IMAGOR_SECRET: {{ .StateValues.imagor.IMAGOR_SECRET | quote }}
      AWS_ACCESS_KEY_ID: {{ .StateValues.s3.AWS_ACCESS_KEY_ID | quote }}
      AWS_SECRET_ACCESS_KEY: {{ .StateValues.s3.AWS_SECRET_ACCESS_KEY | quote }}
      AWS_ENDPOINT: {{ .StateValues.s3.AWS_ENDPOINT | quote }}
      AWS_REGION: {{ .StateValues.s3.AWS_REGION | quote }}
      S3_LOADER_BUCKET: {{ .StateValues.s3.AWS_BUCKET | quote }}
      S3_STORAGE_BUCKET: {{ .StateValues.s3.AWS_BUCKET | quote }}
      S3_RESULT_STORAGE_BUCKET: {{ .StateValues.s3.AWS_BUCKET | quote }}
  neo4j:
    env: {}
