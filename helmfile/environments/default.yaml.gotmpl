{{ $image_tag := env "IMAGE_TAG" | default  (exec "../scripts/branded_image_tag.sh" (list) | trim) }}

deploy:
    GITHUB_REPOSITORY: it4change/paxfamily.social
    IMAGE_TAG: {{ $image_tag }}
    DOMAIN: paxfamily.social.stage.ocelot-social.it4c.org
    REDIRECT_DOMAINS: []
    NAMESPACE: paxfamily-social-staging
    RELEASE_NAME_OCELOT: paxfamily-social-ocelot
    NEO4J_STORAGE: "5Gi"

ocelot:
    options:
        PRODUCTION_DB_CLEAN_ALLOW: "false"
        PUBLIC_REGISTRATION: "false"
        INVITE_REGISTRATION: "true"
        CATEGORIES_ACTIVE: "false"
        MAX_PINNED_POSTS: "1"
        BADGES_ENABLED: "false"
        NETWORK_NAME: "PAX Family"
        ASK_FOR_REAL_NAME: "false"
        REQUIRE_LOCATION: "false"
        MAX_GROUP_PINNED_POSTS: "3"
        API_KEYS_ENABLED: "true"
        API_KEYS_MAX_PER_USER: "5"
        SHOW_CONTENT_FILTER_HEADER_MENU: "false"
        SHOW_CONTENT_FILTER_MASONRY_GRID: "true"
        SHOW_GROUP_BUTTON_IN_HEADER: "true"
        # Contact identity: e-mail/link config, not brand design, so ENV rather than branding.
        # Without them the backend falls back to the ocelot.social defaults.
        SUPPORT_EMAIL: "info@pax.family"
        SUPPORT_LINK: "https://pax.family/kontakt"
        ORGANIZATION_LINK: "https://pax.family"
        # One of brandings/<name>/ by brand id; the images hold all of them.
        OCELOT_ACTIVE_BRANDING: "paxfamily"
